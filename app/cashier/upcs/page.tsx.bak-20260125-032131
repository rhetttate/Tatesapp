"use client";

import Link from "next/link";
import { useEffect, useRef, useState } from "react";
import { supabase } from "../../../lib/supabase";

function onlyDigits(s: string) {
  return (s || "").replace(/\D/g, "");
}

export default function CashierUpcsPage() {
  const [title, setTitle] = useState("Meat Sale");
  const [upcs, setUpcs] = useState<string[]>(Array.from({ length: 8 }, () => ""));
  const [status, setStatus] = useState("");
  const [activeSetId, setActiveSetId] = useState<string | null>(null);

  const refs = useRef<Array<HTMLInputElement | null>>([]);

  useEffect(() => {
    (async () => {
      // load current active set (latest active)
      const { data } = await supabase
        .from("meat_sale_sets")
        .select("id,title,upcs")
        .eq("active", true)
        .order("created_at", { ascending: false })
        .limit(1);

      const row = data?.[0];
      if (row) {
        setActiveSetId(row.id);
        setTitle(row.title || "Meat Sale");
        const arr = Array.isArray(row.upcs) ? row.upcs : [];
        const filled = Array.from({ length: 8 }, (_, i) => arr[i] || "");
        setUpcs(filled);
      }
    })();
  }, []);

  function setAt(i: number, val: string) {
    const copy = [...upcs];
    copy[i] = onlyDigits(val).slice(0, 12); // UPC-A typically 12 digits
    setUpcs(copy);
  }

  function focusNext(i: number) {
    const next = i + 1;
    if (next < 8) refs.current[next]?.focus();
  }

  async function saveSet() {
    setStatus("");
    const cleaned = upcs.map(onlyDigits).filter(Boolean).slice(0, 8);

    if (cleaned.length === 0) return setStatus("Enter at least 1 UPC.");

    try {
      // deactivate previous active sets
      await supabase.from("meat_sale_sets").update({ active: false }).eq("active", true);

      // insert new active set
      const { data, error } = await supabase
        .from("meat_sale_sets")
        .insert({ title: title.trim() || "Meat Sale", upcs: cleaned, active: true })
        .select("id")
        .single();

      if (error) throw error;

      setActiveSetId(data.id);
      setStatus("Saved active UPC set (" + cleaned.length + " codes).");
    } catch (e: any) {
      setStatus("Error: " + (e?.message ?? String(e)));
    }
  }

  return (
    <div className="container">
      <div className="nav">
        <div className="brand">
          <span style={{ width: 10, height: 10, borderRadius: 999, background: "var(--blue)" }} />
          Cashier
          <span className="badge">Meat UPCs</span>
        </div>
        <div style={{ display: "flex", gap: 10 }}>
          <Link className="btn" href="/cashier/member">Member Scan</Link>
          <Link className="btn" href="/">Deals</Link>
        </div>
      </div>

      <div className="card" style={{ padding: 16 }}>
        <div className="muted" style={{ marginBottom: 10 }}>
          Active set: {activeSetId ? activeSetId : "none"}
        </div>

        <label style={{ display: "block", marginBottom: 12 }}>
          Set Title
          <input className="input" value={title} onChange={(e) => setTitle(e.target.value)} />
        </label>

        <div className="grid" style={{ gridTemplateColumns: "repeat(12, 1fr)" }}>
          {upcs.map((v, i) => (
            <div key={i} style={{ gridColumn: "span 12" }}>
              <label style={{ display: "block" }}>
                UPC {i + 1}
                <input
                  ref={(el) => { refs.current[i] = el; }}
                  className="input"
                  value={v}
                  onChange={(e) => setAt(i, e.target.value)}
                  onKeyDown={(e) => {
                    // Many scanners send Enter at end
                    if (e.key === "Enter") {
                      e.preventDefault();
                      focusNext(i);
                    }
                  }}
                  inputMode="numeric"
                  placeholder="12-digit UPC-A"
                />
              </label>
              <div style={{ height: 10 }} />
            </div>
          ))}
        </div>

        <button className="btn btnPrimary" onClick={saveSet} style={{ width: "100%" }}>
          Save Active UPC Set
        </button>

        {status && <p style={{ marginTop: 10 }}>{status}</p>}
      </div>
    </div>
  );
}
